{
  "name": "@nestarc/api-keys",
  "version": "0.3.2",
  "description": "Secure, tenant-scoped API keys for NestJS + Prisma. SHA-256 hashed, Stripe-style scopes, and test/live environments.",
  "license": "MIT",
  "author": "nestarc",
  "repository": "github:nestarc/api-keys",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma/prisma.config.example.ts",
    "prisma/schema.example.prisma",
    "prisma/schema.example.v7.prisma",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e:prisma": "node scripts/test-prisma-e2e.js",
    "test:consumer:strict": "node scripts/test-strict-consumer.js",
    "test:consumer:strict:legacy": "node scripts/test-strict-consumer.js --nest 10.4.20 --prisma 6.19.3",
    "test:consumer:strict:modern": "node scripts/test-strict-consumer.js --nest 11.2.1 --prisma 7.10.0",
    "bench": "ts-node bench/api-keys.bench.ts",
    "bench:smoke": "npm run bench -- --iterations 250 --warmup 50 --timing-threshold-ms 0.5",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestarc/rbac": "^0.2.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@prisma/client": "5.22.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0"
  }
}
